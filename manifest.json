{
  "manifest_version": 3,
  "name": "Link Reputation Scanner (Personal)",
  "version": "0.1.0",
  "description": "Explicit, on-demand link reputation scanning using a user-provided API key. No background scanning. No history.",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "contextMenus",
    "storage"
  ],

  "host_permissions": [
    "https://www.virustotal.com/*"
  ],

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
